{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run AXI Simulation",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "${workspaceFolder}\\run.bat"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Open Waveform",
      "type": "shell",
      "command": "gtkwave axi_lite_tb.vcd",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
