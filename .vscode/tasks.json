{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run AXI Simulation",
      "type": "shell",
      "command": "iverilog -g2012 -o axi_sim rtl/axi_lite_slave.sv tb/axi_lite_tb.sv && vvp axi_sim",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Open Waveform",
      "type": "shell",
      "command": "gtkwave axi_lite_tb.vcd",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
